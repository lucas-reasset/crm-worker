# ── Banco ─────────────────────────────────────────────────────────────────────
# O crm-worker importa o pool do crm-backend (BE-076), então o contrato de conexão é o de lá:
# DATABASE_URL + DB_SCHEMA. Nada de JWT_SECRET/S3 aqui — o validateEnv da API não roda neste
# processo, e este worker não emite sessão nem guarda arquivo.
#
# ⚠️ EM PRODUÇÃO ESTA URL TEM DE SER A DO ROLE RESTRITO, não a do dono do schema. É o que torna a
# regra "o canônico só recebe o validado" uma PERMISSÃO em vez de convenção (D-068). Enquanto o
# role não existir, o rail é papel — ver REQ-0410.
DATABASE_URL=postgres://crm_worker:trocar@localhost:5432/reasset
DB_SCHEMA=crm
DB_POOL_MAX=5

# ── Relógio (SW-016/SW-017) ───────────────────────────────────────────────────
# O BullMQ agenda as varreduras por tempo aqui. OBRIGATÓRIA: sem ela o processo subiria consumindo
# a fila e NÃO seria o relógio — e relógio parado não faz fila crescer, então sumiria sem sinal.
#
# Em dev é o Redis do docker-compose do crm-backend (`redis:7-alpine`), então suba aquele stack
# primeiro. Em AWS é o Valkey Serverless COMPARTILHADO da plataforma, o mesmo que o crm-backend usa:
# `rediss://` (com dois s) é o que liga TLS no ioredis. Não há cache novo a provisionar.
REDIS_URL=redis://localhost:6379

# ── Fila de retorno ───────────────────────────────────────────────────────────
SQS_QUEUE_URL=http://localhost:4566/000000000000/fila-save
AWS_REGION=us-east-1
# Só em dev, apontando para o LocalStack. Vazio = a AWS de verdade.
SQS_ENDPOINT=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test

# Long polling: 20s é o máximo da SQS e evita receive vazio em loop apertado.
SQS_WAIT_TIME_SECONDS=20
SQS_MAX_MESSAGES=10
# ⚠️ Tem de ser COERENTE com a janela de resgatar_mensagens_travadas() (90 min no banco): janela
# menor que a visibilidade faz o Postgres declarar `falhou` uma mensagem ainda em processamento.
SQS_VISIBILITY_TIMEOUT=300

LOG_LEVEL=debug
